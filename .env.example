# ---- Shared ----
# Who can use /snipereset (comma-separated user IDs)
SNIPE_ADMIN_IDS=U0...

# ---- Season boundaries (MM-DD) ----
SNIPE_SPRING_START=01-12
SNIPE_SUMMER_START=05-11
SNIPE_FALL_START=08-20

# ---- Slack (optional — set these to enable the Slack platform) ----
SLACK_BOT_TOKEN=***
SLACK_APP_TOKEN=***
SNIPE_CHANNEL_ID=C0...

# ---- Discord (optional — set these to enable the Discord platform) ----
DISCORD_BOT_TOKEN=***
DISCORD_CLIENT_ID=...
DISCORD_SNIPE_CHANNEL_ID=...
